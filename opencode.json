{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".dev.vars": "deny",
      "**/.dev.vars": "deny",
      "**/*service-role*": "deny",
      "**/*credentials*.json": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sed -n *": "allow",
      "git status *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "npm test *": "allow",
      "npm test": "allow",
      "npm run *": "allow",
      "npx tsc *": "allow",
      "npx playwright *": "allow",
      "npx vite *": "allow",
      "bash supabase/tests/run_*": "allow",
      "bash supabase/tests/dev_*": "allow",
      "psql *127.0.0.1*": "allow",
      "psql *localhost*": "allow",
      "psql *": "ask",
      "supabase link *": "ask",
      "supabase db reset *": "deny",
      "supabase db push *": "deny",
      "supabase migration up *": "ask",
      "git commit *": "deny",
      "git commit": "deny",
      "git push *": "deny",
      "git push": "deny",
      "git merge *": "deny",
      "git rebase *": "deny",
      "git reset *": "deny",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git tag *": "deny",
      "npm publish *": "deny",
      "docker push *": "deny",
      "wrangler deploy *": "deny",
      "vercel *": "deny",
      "netlify *": "deny",
      "gh *": "deny",
      "rm -rf / *": "deny"
    },
    "webfetch": "ask",
    "websearch": "allow",
    "external_directory": {
      "*": "deny"
    },
    "doom_loop": "ask"
  }
}
