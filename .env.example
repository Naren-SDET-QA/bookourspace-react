# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CLIENT CONFIGURATION (PUBLIC / FRONTEND SAFE ONLY)
# BookOurSpace Supabase target: obkfgxjzlscungkhbyvq
# Supabase Auth Callback URL (for Google Cloud Console OAuth Client):
#   https://obkfgxjzlscungkhbyvq.supabase.co/auth/v1/callback
# SECURITY WARNING: Never put any PostgreSQL database password (DATABASE_URL)
# or service-role key (SUPABASE_SERVICE_ROLE_KEY) in frontend environment variables.
VITE_SUPABASE_PROJECT_ID="obkfgxjzlscungkhbyvq"
VITE_SUPABASE_URL="https://obkfgxjzlscungkhbyvq.supabase.co"
VITE_SUPABASE_DEVELOPMENT_PROJECT_ID="obkfgxjzlscungkhbyvq"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Sample listings are development-only fixtures. Production builds always
# exclude them; set true only when intentionally previewing labeled fixtures.
VITE_ENABLE_DEMO_DATA=false

# GOOGLE OAUTH 2.0 CONFIGURATION (SUPABASE OAUTH & POPUP CALLBACK FLOW)
# Configure Authorized Redirect URIs in Google Cloud Console -> Credentials:
#   - https://obkfgxjzlscungkhbyvq.supabase.co/auth/v1/callback
#   - https://ais-dev-huadsxdlh2btbogk3dishx-429336547561.asia-southeast1.run.app/auth/callback
#   - https://ais-pre-huadsxdlh2btbogk3dishx-429336547561.asia-southeast1.run.app/auth/callback
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# SERVER-SIDE SUPABASE POSTGRESQL & STRICT PRODUCTION ENFORCEMENT
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
BOS_STRICT_PRODUCTION_MODE="false"

# AUTHORIZED CINEMA POS & PSP BANK WEBHOOK SECRETS (SERVER-SIDE ONLY)
CINEMA_POS_API_URL=""
BOS_CINEMA_POS_KEY="replace-with-cinema-pos-hmac-secret"
NPCI_LIVE_WEBHOOK_SECRET="replace-with-psp-bank-webhook-secret"
PSP_REFUND_API_URL=""

# RAZORPAY PAYMENT & REFUND GATEWAY (MOVIES, HOTELS & HOME STAYS ONLY)
# Backend
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"
VITE_RAZORPAY_KEY_ID="your-razorpay-key-id"

# SERVER-SIDE CRYPTOGRAPHIC SIGNING SECRET (HMAC-SHA256 FOR SESSIONS, QR PASSES & WEBHOOKS)
BOS_SERVER_HMAC_SECRET="your-server-hmac-secret-placeholder"

# ---------------------------------------------------------------------------
# BOOKING DATABASE (POSTGRESQL IS THE AUTHORITY FOR BOOKINGS/INVENTORY)
# ---------------------------------------------------------------------------
# The canonical, loopback-only PostgreSQL connection used by the provider
# listing, stay, PG, services, classes and venue booking repositories.
# The connection string must point at localhost/127.0.0.1/::1.
# BOS_PG_URL is rejected; use this variable only.
BOS_LISTINGS_DATABASE_URL="postgres://postgres@127.0.0.1:5432/bookourspace?sslmode=disable"

# ---------------------------------------------------------------------------
# PAYMENT SETTINGS (UPI INTENT / PAY AT PROPERTY / SIGNED SETTLEMENT)
# ---------------------------------------------------------------------------
# The UPI merchant address that receives money. It is only offered in the UI
# when a signed settlement path also exists. Leave empty in production to
# disable online UPI entirely.
BOS_UPI_MERCHANT_VPA=""
BOS_UPI_MERCHANT_NAME="BookOurSpace"

# Local sandbox payment provider. Settlement only becomes "verified" after a
# provider event signed with this secret is reconciled by the server.
# Requires BOS_PAYMENT_SANDBOX=1, a secret of at least 16 characters and
# NODE_ENV other than production.
BOS_PAYMENT_SANDBOX=""
BOS_PAYMENT_SANDBOX_SECRET=""

# EMAIL NOTIFICATION INTEGRATION (GMAIL SMTP / HOSPITAL SAAS)
EMAIL_PROVIDER="gmail"
GMAIL_USER="your-hospital-or-service-email@gmail.com"
GMAIL_APP_PASSWORD="your-google-app-password"
EMAIL_FROM="Sri Srinivasa Hospital <your-hospital-or-service-email@gmail.com>"

# WHATSAPP NOTIFICATION INTEGRATION (META CLOUD API)
WHATSAPP_PROVIDER="meta"
WHATSAPP_ACCESS_TOKEN="your-meta-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id"
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_TEMPLATE_NAME="hello_world"
WHATSAPP_TEMPLATE_LANG="en_US"



# Explicit local allowlist for the prepared Mumbai project. Placeholder keys
# above keep live Supabase disabled until the owner configures public values.
