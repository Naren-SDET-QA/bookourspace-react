# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CLIENT CONFIGURATION (PUBLIC / FRONTEND SAFE ONLY)
# Configured for BookOurSpace Supabase Project: ezrxykyocgbolpaebnqx
# Supabase Auth Callback URL (for Google Cloud Console OAuth Client):
#   https://ezrxykyocgbolpaebnqx.supabase.co/auth/v1/callback
# SECURITY WARNING: Never put any PostgreSQL database password (DATABASE_URL)
# or service-role key (SUPABASE_SERVICE_ROLE_KEY) in frontend environment variables.
VITE_SUPABASE_PROJECT_ID="ezrxykyocgbolpaebnqx"
VITE_SUPABASE_URL="https://ezrxykyocgbolpaebnqx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# GOOGLE OAUTH 2.0 CONFIGURATION (SUPABASE OAUTH & POPUP CALLBACK FLOW)
# Configure Authorized Redirect URIs in Google Cloud Console -> Credentials:
#   - https://ezrxykyocgbolpaebnqx.supabase.co/auth/v1/callback
#   - https://ais-dev-2sp75t3mb2qar3lhuhwjxd-429336547561.asia-southeast1.run.app/auth/callback
#   - https://ais-pre-2sp75t3mb2qar3lhuhwjxd-429336547561.asia-southeast1.run.app/auth/callback
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# SERVER-SIDE CRYPTOGRAPHIC SIGNING SECRET (HMAC-SHA256 FOR SESSIONS, QR PASSES & WEBHOOKS)
BOS_SERVER_HMAC_SECRET="replace-with-strong-32-byte-production-secret"

# RAZORPAY SERVER-SIDE CHECKOUT (NEVER PREFIX WITH VITE_)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="replace-with-razorpay-secret"


# Movies uses its own verified Supabase session; never configure a secret/service-role key here.
VITE_MOVIES_SUPABASE_URL=https://ezrxykyocgbolpaebnqx.supabase.co
VITE_MOVIES_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Local Vite development shows the built-in original Movies demo by default.
# Set VITE_MOVIES_DEMO_MODE=false locally to exercise the live Supabase feed/admin UI.
# Never use demo mode as a production data source.
# Optional dedicated server/worker variables. These must never have a VITE_ prefix.
# MOVIES_SUPABASE_URL=https://ezrxykyocgbolpaebnqx.supabase.co
# MOVIES_SYNC_SERVICE_KEY=set-only-on-the-private-sync-worker
# MOVIES_FEED_URL=https://your-authorized-provider.example/feed.json
# MOVIES_FEED_TOKEN=set-only-if-the-provider-requires-authentication
