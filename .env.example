# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: local or deployed origin used for OAuth redirects and self links.
# Local development:
APP_URL="http://localhost:5173"

# SUPABASE CLIENT CONFIGURATION (PUBLIC / FRONTEND SAFE ONLY)
# BookOurSpace Supabase target: obkfgxjzlscungkhbyvq (Mumbai, ap-south-1)
# Google Cloud Console -> Credentials -> Authorized redirect URIs:
#   https://obkfgxjzlscungkhbyvq.supabase.co/auth/v1/callback
# SECURITY WARNING: Never put a PostgreSQL password, service-role key,
# sb_secret_ key, or GOOGLE_CLIENT_SECRET in any VITE_* variable.
# This file is the DEVELOPMENT template. A production deployment must not reuse
# these values: production requires an explicit dedicated project reference
# (deploy/env.production.example, BOS_PRODUCTION_SUPABASE_PROJECT_ID) and
# refuses the development project.
VITE_SUPABASE_PROJECT_ID="obkfgxjzlscungkhbyvq"
VITE_SUPABASE_URL="https://obkfgxjzlscungkhbyvq.supabase.co"
VITE_SUPABASE_DEVELOPMENT_PROJECT_ID="obkfgxjzlscungkhbyvq"
# Live publishable key lives in gitignored .env / .env.local. This placeholder
# keeps the example committable and leaves the client disabled until configured.
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Sample listings are development-only fixtures. Production builds always
# exclude them; set true only when intentionally previewing labeled fixtures.
VITE_ENABLE_DEMO_DATA=false

# GOOGLE SIGN-IN — delegated to Mumbai Supabase Auth (not a Vite OAuth client).
# The browser calls supabase.auth.signInWithOAuth({ provider: 'google' }).
# Put the Google Cloud Web client ID and secret only in:
#   Supabase dashboard -> Authentication -> Providers -> Google
# Redirect URLs in Supabase Auth URL configuration:
#   http://localhost:5173/auth/callback
#   <production origin>/auth/callback
# These placeholders are unused by the current app; do not paste secrets here.
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# SERVER-SIDE SUPABASE & STRICT PRODUCTION ENFORCEMENT
# Operator database URL belongs in gitignored .env.local as BOS_MUMBAI_DATABASE_URL.
# Local development defaults to the isolated JSON compatibility store. To use
# the confirmed development Supabase database, explicitly opt in below and
# allowlist its project/host. This remains server-only and must use TLS.
# Production (NODE_ENV=production): set BOS_LISTINGS_DATABASE_URL to the Mumbai
# pooler URL with sslmode=verify-full (or require). Never point production at
# localhost. Prefer a server-only Supabase secret key. Never use a VITE_ prefix
# or expose it to the browser. The legacy service-role JWT remains a server-only fallback.
SUPABASE_SECRET_KEY="your-server-only-supabase-secret-key"
# SUPABASE_SERVICE_ROLE_KEY="your-legacy-server-only-service-role-jwt"
BOS_STRICT_PRODUCTION_MODE="false"

# AUTHORIZED CINEMA POS & PSP BANK WEBHOOK SECRETS (SERVER-SIDE ONLY)
CINEMA_POS_API_URL=""
BOS_CINEMA_POS_KEY="replace-with-cinema-pos-hmac-secret"
NPCI_LIVE_WEBHOOK_SECRET="replace-with-psp-bank-webhook-secret"
PSP_REFUND_API_URL=""

# RAZORPAY PAYMENT & REFUND GATEWAY (HOTELS & STAYS + PG)
# Backend. Production Stays Razorpay Checkout and verified UPI QR require all three.
# Razorpay dashboard webhook URLs:
#   https://<api-host>/api/stays/payments/razorpay/webhook
#   https://<api-host>/api/pg/payments/razorpay/webhook
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"
VITE_RAZORPAY_KEY_ID="your-razorpay-key-id"

# SERVER-SIDE CRYPTOGRAPHIC SIGNING SECRET (HMAC-SHA256 FOR SESSIONS, QR PASSES & WEBHOOKS)
BOS_SERVER_HMAC_SECRET="your-server-hmac-secret-placeholder"
# Optional separate HMAC key for server-issued booking QR tokens. Falls back to
# BOS_SERVER_HMAC_SECRET when empty.
BOS_BOOKING_QR_SECRET=""

# ---------------------------------------------------------------------------
# BOOKING DATABASE (POSTGRESQL IS THE AUTHORITY FOR BOOKINGS/INVENTORY)
# ---------------------------------------------------------------------------
# Canonical PostgreSQL URL for provider listing, stay, PG, services, classes
# and venue booking repositories. BOS_PG_URL is rejected; use this variable only.
# Development/test: loopback by default. Remote development requires the
# explicit allowlist below; production rules remain fail-closed and unchanged.
BOS_LISTINGS_DATABASE_URL="postgres://postgres@127.0.0.1:5432/bookourspace?sslmode=disable"
BOS_ALLOW_REMOTE_DEVELOPMENT_DATABASE="0"
BOS_DEVELOPMENT_DATABASE_PROJECT_ID="obkfgxjzlscungkhbyvq"
# Set this only when using an approved Supabase pooler hostname instead of
# db.<project-id>.supabase.co. Never put a database URL in any VITE_* variable.
BOS_DEVELOPMENT_DATABASE_HOST=""

# Optional uncommon-area search through Google Places API (New).
# Server only: never add a VITE_ prefix. Restrict this credential by server IP,
# enable Places API (New), configure billing/quotas, and follow Maps attribution
# and content-retention terms. Provider results are never cached by BookOurSpace.
GOOGLE_MAPS_PLACES_API_KEY=""
# Set true only after the app Terms and Privacy Policy include Google Maps terms/privacy links.
BOS_GOOGLE_MAPS_TERMS_READY="false"
# Production example (do not commit a real password):
# BOS_LISTINGS_DATABASE_URL="postgresql://postgres.obkfgxjzlscungkhbyvq:SECRET@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=verify-full"

# ---------------------------------------------------------------------------
# PAYMENT SETTINGS (UPI INTENT / PAY AT PROPERTY / SIGNED SETTLEMENT)
# ---------------------------------------------------------------------------
# Local sandbox UPI VPA. Production verified UPI uses Razorpay UPI QR (no
# screenshot/UTR path). Leave empty if only Razorpay Checkout and pay-at-property
# should be offered.
BOS_UPI_MERCHANT_VPA=""
BOS_UPI_MERCHANT_NAME="BookOurSpace"

# GST tax invoice on stay receipts. Leave GSTIN empty to issue a booking/payment
# receipt instead of a GST tax invoice. SAC 996311 is hotel accommodation.
BOS_GSTIN=""
BOS_GST_LEGAL_NAME=""
BOS_GST_SUPPLIER_ADDRESS=""
BOS_GST_PLACE_OF_SUPPLY=""
BOS_GST_SAC_CODE=""
BOS_GST_IGST=""
# Tax invoices stay disabled until supplier registration, applicable tax rules
# and statutory invoice requirements have each been independently verified.
BOS_GST_SUPPLIER_VERIFIED=""
BOS_GST_TAX_RULES_VERIFIED=""
BOS_GST_INVOICE_REQUIREMENTS_VERIFIED=""

# Stay search always drops payload.demo listings in production. Locally they are
# hidden by default too: set this to 1 (the preview opt-in used by
# scripts/dev-with-stays-db.sh) to show the seeded Airbnb-style catalog with its
# photos, or leave it unset/0 to hide that catalog locally as well.
# BOS_STAY_INCLUDE_DEMO="1"

# Local preview only: when set to 1 outside production, the seeded demo stays
# are also bookable end to end (hold, checkout, cancel). Production never sets
# this, and demo rows remain unbookable by default.
# BOS_STAY_ALLOW_DEMO_BOOKING="1"

# Local sandbox payment provider. Settlement only becomes "verified" after a
# provider event signed with this secret is reconciled by the server.
# Requires BOS_PAYMENT_SANDBOX=1, a secret of at least 16 characters and
# NODE_ENV other than production.
BOS_PAYMENT_SANDBOX=""
BOS_PAYMENT_SANDBOX_SECRET=""

# EMAIL NOTIFICATION INTEGRATION (GMAIL SMTP / HOSPITAL SAAS)
EMAIL_PROVIDER="gmail"
GMAIL_USER="your-hospital-or-service-email@gmail.com"
GMAIL_APP_PASSWORD="your-google-app-password"
EMAIL_FROM="Sri Srinivasa Hospital <your-hospital-or-service-email@gmail.com>"

# WHATSAPP NOTIFICATION INTEGRATION (META CLOUD API)
WHATSAPP_PROVIDER="meta"
WHATSAPP_ACCESS_TOKEN="your-meta-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id"
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_TEMPLATE_NAME="hello_world"
WHATSAPP_TEMPLATE_LANG="en_US"



# Explicit local allowlist for the prepared Mumbai project. Placeholder keys
# above keep live Supabase disabled until the owner configures public values.
# Capacitor native API: set the approved production HTTPS backend origin when known.
# Do not guess or set the Supabase URL here; this is the BookOurSpace API server.
# Production Node must serve HTTPS (or sit behind a TLS terminator) with:
#   NODE_ENV=production
#   APP_URL=https://<canonical-api-host>
#   VITE_NATIVE_API_ORIGIN=https://<canonical-api-host>   # baked at native build time
#   BOS_LISTINGS_DATABASE_URL=<Mumbai pooler URI>?sslmode=require
# HTTP is allowed only for loopback native debugging (localhost, 127.0.0.1, [::1], 10.0.2.2).
VITE_NATIVE_API_ORIGIN=
# Capacitor iOS and Android WebView origins; the API CORS allowlist is exact-match.
BOS_NATIVE_APP_ORIGINS=https://localhost,capacitor://localhost

# Local development sign-in (never enable in production). It only selects an
# existing seeded profile and never creates users; the UI shows Customer/Admin
# demo buttons when this is on.
# BOS_LOCAL_DEV_AUTH="1"
# VITE_BOS_LOCAL_DEV_AUTH="1"

# Use the local PostgreSQL live-page config API when Supabase is not configured.
# VITE_BOS_LIVE_PAGE_LOCAL="1"

# ---------------------------------------------------------------------------
# EMAIL ONE-TIME-CODE SIGN-IN (SUPABASE AUTH ADMIN + RESEND)
# ---------------------------------------------------------------------------
# The API server creates/finds the Supabase user, asks Supabase Admin to
# generate a one-time code, and emails that code through Resend. Supabase Auth
# still verifies the code and issues the session; no password is stored.
# Server-only values. Never add a VITE_ prefix to any secret.
# SUPABASE_SECRET_KEY (above) is required for the Admin API.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a verified Resend domain, e.g. "BookOurSpace <login@bookourspace.in>".
RESEND_FROM_EMAIL="BookOurSpace <login@bookourspace.in>"
RESEND_REPLY_TO="support@bookourspace.in"
# Optional local/test override for the Resend API origin (https or loopback).
# RESEND_API_BASE_URL="http://127.0.0.1:4010"
BOS_SUPPORT_EMAIL="support@bookourspace.in"

# Public sign-in switches. The admin console writes these to the database
# (app_settings.authAccess); these env values are only the initial/default
# fallback when no admin setting exists. Guest browsing is OFF by default.
BOS_GUEST_LOGIN_ENABLED="false"
BOS_EMAIL_OTP_ENABLED="true"
BOS_GOOGLE_LOGIN_ENABLED="true"
# Development-only fallback file when no database is configured. Gitignored.
# BOS_AUTH_SETTINGS_FILE=".bos-auth-settings.json"

# ---------------------------------------------------------------------------
# Optional demo fixtures. Off by default everywhere, including the Google AI
# Studio /app/applet preview, which therefore shows real configured data.
# To preview sample content deliberately, set BOTH values explicitly:
# VITE_ENABLE_DEMO_DATA="true"
# VITE_AI_STUDIO_DEMO="true"
# Never treat fixture cards as marketplace inventory.
# ---------------------------------------------------------------------------
