{
  "name": "bookourspace-aistudio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:local": "bash scripts/dev-with-stays-db.sh",
    "dev:web": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.mjs",
    "e2e": "playwright test --project=chromium",
    "e2e:classes": "playwright test e2e/classes-journey.spec.ts --project=chromium",
    "test:db": "bash supabase/tests/run_local_validation.sh",
    "test:db:stay-payments": "bash supabase/tests/run_stay_payment_e2e.sh",
    "test:services": "bash supabase/tests/run_services_e2e.sh",
    "test:services:ui": "bash supabase/tests/run_services_ui_e2e.sh",
    "test:institute:db": "node supabase/tests/institute_management_e2e.mjs",
    "test:institute:http": "node supabase/tests/institute_management_http_e2e.mjs",
    "test:db:pg": "bash supabase/tests/run_pg_integration.sh",
    "test:db:pg-payments": "bash supabase/tests/run_pg_payment_e2e.sh",
    "test:db:pg-admin": "bash supabase/tests/run_pg_admin_e2e.sh",
    "test:db:mumbai-oauth": "bash supabase/tests/run_mumbai_oauth_e2e.sh",
    "audit:duplicates": "node scripts/audit-duplicate-routes.mjs",
    "audit:oauth": "tsx scripts/check-google-oauth.mjs",
    "supabase:use": "bash scripts/use-supabase-project.sh",
    "seed:stays": "tsx scripts/seed-stays-demo.ts",
    "seed:locations": "tsx scripts/seed-india-locations.ts",
    "supabase:preflight": "tsx scripts/supabase-dev-preflight.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:android:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "cap:ios:debug": "npm run build && cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -configuration Debug CODE_SIGNING_ALLOWED=NO build",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "^8.0.3",
    "@google-pay/button-react": "^4.1.0",
    "@google/genai": "^2.32.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "0.9.12",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1",
    "resend": "^6.38.0",
    "sharp": "0.35.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
