# ---------------------------------------------------------------------------
# BookOurSpace production environment — TEMPLATE ONLY
# Supabase project: __PRODUCTION_SUPABASE_PROJECT_REF__ (dedicated production project)
#
# Do not commit real values. Do not load this file into a public build.
# Server-only values belong in Google Secret Manager; public Vite values are
# safe to expose but must still be supplied by the owner.
#
# HARD RULE: never put a database password, HMAC secret, service-role key,
# Supabase secret key or sb_secret_ value in any VITE_* variable.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Filled from `gcloud run services describe ... --format='value(status.url)'`
# after the first revision. Never invent or hard-code this hostname.
APP_URL=__CANONICAL_HTTPS_API_URL__

# --------------------------- Supabase target ------------------------------
# REQUIRED and explicit. Set this to the dedicated PRODUCTION project
# reference. Production startup fails closed when it is unset, when the
# Supabase variables disagree with it, or when any of them names the
# development project (or a legacy/retired project). Never reuse the
# development project here.
BOS_PRODUCTION_SUPABASE_PROJECT_ID=__PRODUCTION_SUPABASE_PROJECT_REF__

# --------------------------- Supabase (public client) ---------------------
# Both values must describe __PRODUCTION_SUPABASE_PROJECT_REF__.
VITE_SUPABASE_PROJECT_ID=__PRODUCTION_SUPABASE_PROJECT_REF__
VITE_SUPABASE_URL=https://__PRODUCTION_SUPABASE_PROJECT_REF__.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=__PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY__
VITE_SUPABASE_ANON_KEY=__PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY__

# --------------------------- Supabase (server only) -----------------------
SUPABASE_URL=https://__PRODUCTION_SUPABASE_PROJECT_REF__.supabase.co
SUPABASE_PROJECT_ID=__PRODUCTION_SUPABASE_PROJECT_REF__
SUPABASE_PUBLISHABLE_KEY=__PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY__
# Secret Manager: supabase-secret-key. Never expose to the browser.
SUPABASE_SECRET_KEY=__SECRET_MANAGER_ONLY__
# SUPABASE_SERVICE_ROLE_KEY=__SECRET_MANAGER_ONLY__

# --------------------------- Email OTP delivery (server only) --------------
# Secret Manager: resend-api-key. The API generates the code with Supabase
# Admin and sends it through Resend; never put these in VITE_* variables.
RESEND_API_KEY=__SECRET_MANAGER_ONLY__
RESEND_FROM_EMAIL=BookOurSpace <login@bookourspace.in>
RESEND_REPLY_TO=support@bookourspace.in
BOS_SUPPORT_EMAIL=support@bookourspace.in
# Initial policy only. The admin console writes app_settings.authAccess in
# PostgreSQL, and that stored value takes precedence. Guest browsing is OFF by
# default; enable it only through the admin console (or this env default).
BOS_GUEST_LOGIN_ENABLED=false
BOS_EMAIL_OTP_ENABLED=true
BOS_GOOGLE_LOGIN_ENABLED=true

# --------------------------- Database (server only) -----------------------
# Supabase Mumbai pooler URI with sslmode=verify-full or require.
# Secret Manager: bos-listings-database-url.
BOS_LISTINGS_DATABASE_URL=__SECRET_MANAGER_ONLY__

# --------------------------- Crypto (server only) -------------------------
# Secret Manager: bos-server-hmac-secret (64+ random characters).
BOS_SERVER_HMAC_SECRET=__SECRET_MANAGER_ONLY__
# BOS_BOOKING_QR_SECRET=__SECRET_MANAGER_ONLY__   # optional separate QR key

# --------------------------- Production safety flags ----------------------
# Demo fixtures/auth and sandbox money must be disabled in production.
VITE_ENABLE_DEMO_DATA=false
VITE_BOS_LOCAL_DEV_AUTH=0
BOS_LOCAL_DEV_AUTH=0
BOS_STAY_INCLUDE_DEMO=0
BOS_STAY_ALLOW_DEMO_BOOKING=0
BOS_PAYMENT_SANDBOX=0
BOS_PAYMENT_SANDBOX_SECRET=
BOS_UPI_SANDBOX=0
BOS_VENUE_PAYMENT_SANDBOX=0
BOS_VENUE_PAYMENT_SANDBOX_SECRET=
BOS_ALLOW_OWNER_MANUAL_SETTLEMENT=false

# Exact Capacitor origins only (no wildcard).
BOS_NATIVE_APP_ORIGINS=capacitor://localhost,https://localhost

# --------------------------- Payment providers (server only) --------------
# Live values are Secret Manager inputs; do not place them in VITE_ variables.
RAZORPAY_KEY_ID=__SERVER_SIDE_RAZORPAY_KEY_ID__
RAZORPAY_KEY_SECRET=__SECRET_MANAGER_ONLY__
RAZORPAY_WEBHOOK_SECRET=__SECRET_MANAGER_ONLY__
# The browser Checkout key id is publishable but still supplied at build time.
VITE_RAZORPAY_KEY_ID=__PUBLIC_RAZORPAY_KEY_ID__

# --------------------------- Native build only ----------------------------
# Set at native build time to the same canonical HTTPS API origin. Web builds
# use relative /api paths and do not need this.
# VITE_NATIVE_API_ORIGIN=__CANONICAL_HTTPS_API_URL__
