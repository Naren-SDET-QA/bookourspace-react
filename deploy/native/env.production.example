# Native production build environment — TEMPLATE ONLY
#
# Set VITE_NATIVE_API_ORIGIN from `gcloud run services describe ... status.url`
# after an approved deployment. Never invent a hostname.
#
# VITE_ values are baked into the app bundle. Never put a database password,
# HMAC secret, service-role key, Supabase secret key or sb_secret_ here.

VITE_NATIVE_API_ORIGIN=__CANONICAL_HTTPS_API_URL__

# Demo auth/fixtures and sandbox payments must all be off for release builds.
VITE_ENABLE_DEMO_DATA=false
VITE_BOS_LOCAL_DEV_AUTH=0
BOS_PAYMENT_SANDBOX=0
BOS_UPI_SANDBOX=0
BOS_VENUE_PAYMENT_SANDBOX=0
BOS_STAY_INCLUDE_DEMO=0
BOS_STAY_ALLOW_DEMO_BOOKING=0

# Public Supabase client values for the dedicated PRODUCTION project.
# Never the development project; the release build refuses it.
VITE_SUPABASE_PROJECT_ID=<production-project-ref>
VITE_SUPABASE_URL=https://<production-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=__PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY__
VITE_SUPABASE_ANON_KEY=__PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY__

# Public Razorpay Checkout key id only; the key secret stays server-side.
VITE_RAZORPAY_KEY_ID=__PUBLIC_RAZORPAY_KEY_ID__
